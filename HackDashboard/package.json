{
  "name": "vetsentinel",
  "private": true,
  "version": "0.1.0",
  "description": "VetSentinel - Veterinary Emergency & Toxicology Triage Support System",
  "type": "module",
  "author": "Danilo Fiumi",
  "scripts": {
    "dev": "concurrently -k -n admin,manager,pb -c cyan,magenta,yellow \"cross-env APP_TARGET=admin vite dev --port 5173\" \"cross-env APP_TARGET=manager vite dev --port 5174\" \"./scripts/run-pb.sh\"",
    "dev:admin": "cross-env APP_TARGET=admin vite dev --port 5173",
    "dev:manager": "cross-env APP_TARGET=manager vite dev --port 5174",
    "dev:marketing": "cross-env APP_TARGET=marketing vite dev --port 5175",
    "build:admin": "cross-env APP_TARGET=admin vite build",
    "build:manager": "cross-env APP_TARGET=manager vite build",
    "build:marketing": "cross-env APP_TARGET=marketing vite build",
    "build:all": "bun run build:admin && bun run build:manager && bun run build:marketing",
    "mobile": "utils/run-mobile.sh",
    "devcomp": "vite",
    "full": "vite dev & cd app/pb/ && ./pocketbase serve & python app/py/main.py",
    "build": "vite build",
    "commit": "vite build && git add . && git commit -m \"a\" && git push origin main",
    "fullbuild": "vite build && vite -c vite.webcomponents.config.js build",
    "comp": "vite -c vite.webcomp.config.js build && cp static/web-comps/boundle.js app/pb/pb_public/v1",
    "native": "cross-env NODE_ENV=dev bun run dev:all",
    "dev:all": "concurrently -n=svelte,electron -c='#ff3e00',blue \"bun run dev:svelte\" \"bun run dev:electron\"",
    "dev:svelte": "vite dev",
    "dev:electron": "electron app/native/electron.cjs",
    "fullapp": "vite dev & python app/native/app.py debug",
    "build:unpack": "bun run build:svelte && electron-builder --dir",
    "build:native": "cross-env NODE_ENV=production bun run build:svelte && bun run build:electron",
    "build:svelte": "cross-env RELATIVE_PATHS=true vite build",
    "build:electron": "electron-builder -mwl --config build.config.json",
    "build:win": "bun run build:svelte && electron-builder --win",
    "build:mac": "bun run build:svelte && electron-builder --mac",
    "build:package": "python3 app/native/pre_build.py && bun run build:svelte && electron-builder --mac && python3 app/native/post_build.py",
    "build:linux": "bun run build:svelte && electron-builder --linux",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.37",
    "svelte": "^5.55.2",
    "tailwindcss": "4.3.3",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "better-sqlite3": "^12.10.0",
    "pocketbase": "^0.27.0",
    "posthog-js": "^1.386.1",
    "svelte-markdown": "^0.4.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
